diff --git a/container.c b/container.c
index 9afb5bd..1b91759 100644
--- a/container.c
+++ b/container.c
@@ -367,17 +367,23 @@ static size_t build_ele3(const bin_info *b, uint8_t *nc, size_t cap, const overr
         if (section_bytes(c + (stored ? sec.offset : b->len), stored, ov, compressed, &sdata, &slen,
                           &packed, level) < 0)
             return (size_t)-1;
-        if (!fits(cap, pos, slen) ||
+        /* Newly packed ELE3 sections include zero padding in the table length,
