             free(packed);
             return (size_t)-1;
         }
         memcpy(nc + pos, sdata, slen);
+        memset(nc + pos + slen, 0, padded_len - slen);
         uint8_t *e = nc + ELE3_TABLE_OFF + s * ELE3_ENTRY_SZ;
         wr32be(e + 4, (uint32_t)pos);
-        wr32be(e + 8, (uint32_t)slen);
+        wr32be(e + 8, (uint32_t)padded_len);
         free(packed);
-        pos += slen;
+        pos += padded_len;
     }
     return pos;
 }
